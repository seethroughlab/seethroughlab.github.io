---
import { readdir } from 'node:fs/promises';
import { join } from 'node:path';
import Base from '../../layouts/Base.astro';
import VideoPlayer from '../../components/VideoPlayer.astro';
import ImageCarousel from '../../components/ImageCarousel.astro';
import { getCollection, render } from 'astro:content';

export async function getStaticPaths() {
  const MEDIA_RE = /\.(jpe?g|png|gif|webp|avif|mp4)$/i;
  const projects = await getCollection('projects');
  const paths = await Promise.all(
    projects.map(async (project) => {
      const slug = project.data.slug;
      const dir = join(process.cwd(), 'public', 'images', 'projects', slug);
      let images: string[] = [];
      try {
        const files = await readdir(dir);
        images = files
          .filter((f) => MEDIA_RE.test(f))
          .sort()
          .map((f) => `/images/projects/${slug}/${f}`);
      } catch {
        // No image directory for this project
      }
      return {
        params: { slug },
        props: { project, images },
      };
    })
  );
  return paths;
}

const { project, images } = Astro.props;
const { title, client, year, coverImage, videoSrc, role, tech, tags, videos, credits, links } = project.data;

const tagToSlug = (t: string) =>
  t.toLowerCase().replace(/ \/ /g, '-').replace(/ /g, '-');
const { Content } = await render(project);

const hasVideo = !!videoSrc;
const hasCarousel = images.length > 0;
const carouselImages = hasVideo && coverImage
  ? images.filter((img) => img !== coverImage)
  : images;
const videoPoster = coverImage || (videoSrc
  ? videoSrc.replace('index.m3u8', 'poster.jpg')
  : undefined);

const ogImage = coverImage || images[0] || (videoSrc
  ? videoSrc.replace('index.m3u8', 'poster.jpg')
  : undefined);

const pageDescription = [client, year, role].filter(Boolean).join(' · ')
  || 'Experimental art & technology studio.';
---

<Base title={`${title} | See Through Lab`} description={pageDescription} ogImage={ogImage}>
  <article class="py-12">
    {/* Hero: video+carousel unified > video only > carousel > cover image */}
    {(hasVideo || videos.length > 0) && (carouselImages.length > 0 || videos.length > 0) ? (
      <ImageCarousel images={carouselImages} title={title} videoSrc={videoSrc} videoPoster={videoPoster} additionalVideos={videos} />
    ) : hasVideo ? (
      <div class="max-w-5xl mx-auto mb-12">
        <VideoPlayer src={videoSrc} poster={videoPoster} />
      </div>
    ) : hasCarousel ? (
      <ImageCarousel images={images} title={title} />
    ) : coverImage ? (
      <div class="max-w-5xl mx-auto aspect-video overflow-hidden mb-12">
        <img
          src={coverImage}
          alt={title}
          class="w-full h-full object-cover"
        />
      </div>
    ) : null}

    {/* Metadata header */}
    <div class="max-w-3xl mx-auto">
      <h1 class="font-serif text-4xl md:text-5xl mb-8">{title}</h1>

      <dl class="mb-12 space-y-5 text-sm">
        {(client || year) && (
          <div class="grid grid-cols-[7rem_1fr] gap-2">
            <dt class="text-[0.65rem] uppercase tracking-widest text-text-muted pt-0.5">
              {client && year ? 'Client · Year' : client ? 'Client' : 'Year'}
            </dt>
            <dd class="text-text-primary">
              {[client, year].filter(Boolean).join(' · ')}
            </dd>
          </div>
        )}

        {role && (
          <div class="grid grid-cols-[7rem_1fr] gap-2">
            <dt class="text-[0.65rem] uppercase tracking-widest text-text-muted pt-0.5">Role</dt>
            <dd class="text-text-primary">{role}</dd>
          </div>
        )}

        {tags.length > 0 && (
          <div class="grid grid-cols-[7rem_1fr] gap-2">
            <dt class="text-[0.65rem] uppercase tracking-widest text-text-muted pt-0.5">Tags</dt>
            <dd class="flex flex-wrap gap-x-3 gap-y-1">
              {tags.map((t) => (
                <a
                  href={`/projects/tag/${tagToSlug(t)}`}
                  class="text-text-muted hover:text-text-primary transition-colors duration-200 uppercase tracking-wider text-xs"
                >
                  {t}
                </a>
              ))}
            </dd>
          </div>
        )}

        {credits.length > 0 && (
          <div class="grid grid-cols-[7rem_1fr] gap-2">
            <dt class="text-[0.65rem] uppercase tracking-widest text-text-muted pt-0.5">Team</dt>
            <dd>
              <dl class="space-y-1">
                {credits.map(({ role: r, name, url }) => (
                  <div class="grid grid-cols-[10rem_1fr] gap-2">
                    <dt class="text-text-muted">{r}</dt>
                    <dd>
                      {url
                        ? <a href={url} target="_blank" rel="noopener noreferrer" class="text-text-primary hover:underline">{name}</a>
                        : <span class="text-text-primary">{name}</span>
                      }
                    </dd>
                  </div>
                ))}
              </dl>
            </dd>
          </div>
        )}

        {tech.length > 0 && (
          <div class="grid grid-cols-[7rem_1fr] gap-2">
            <dt class="text-[0.65rem] uppercase tracking-widest text-text-muted pt-0.5">Tech</dt>
            <dd class="flex flex-wrap gap-2">
              {tech.map((t) => (
                <span class="text-xs uppercase tracking-wider text-text-muted border border-border px-3 py-1 rounded-full">
                  {t}
                </span>
              ))}
            </dd>
          </div>
        )}

        {links.length > 0 && (
          <div class="grid grid-cols-[7rem_1fr] gap-2">
            <dt class="text-[0.65rem] uppercase tracking-widest text-text-muted pt-0.5">Press</dt>
            <dd>
              <ul class="space-y-1">
                {links.map(({ label, url }) => (
                  <li>
                    <a
                      href={url}
                      target="_blank"
                      rel="noopener noreferrer"
                      class="text-text-primary hover:underline"
                    >
                      {label} &rarr;
                    </a>
                  </li>
                ))}
              </ul>
            </dd>
          </div>
        )}
      </dl>

      {/* MDX body */}
      <div class={`prose${hasCarousel ? ' prose-no-images' : ''}`}>
        <Content />
      </div>

      {/* Back navigation */}
      <a
        href="/"
        class="inline-block mt-16 text-text-muted hover:text-text-primary transition-colors duration-200 text-sm uppercase tracking-widest"
      >
        &larr; Back to Work
      </a>
    </div>
  </article>
</Base>
