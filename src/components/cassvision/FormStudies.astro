---
// Form studies: three ways to hold a camera you look at instead of through, and the sized-down rear-screen
// body that was chosen. From the Cassvision repo's tools/viewer/form-studies.html; every drawing shares one mm scale.
import './cassvision.css';
---

<div class="cv" data-cassvision-forms>
  <p class="cv-note">Each study has a Super 8 style grip and the controls planned at the time: two knobs, REC, FX and a recording light. (Since 2026-10-10 the controls are just the REC trigger; the look is automatic.) Every drawing uses the same scale in millimetres, so sizes compare directly.</p>

  <section class="cv-sheet" aria-labelledby="cv-mini-h">
    <div class="cv-sheet-head"><h3 id="cv-mini-h">A-mini · rear screen, sized down</h3><span class="cv-tag">chosen direction · ghost outline = original A</span></div>
    <div class="cv-drawing">
      <svg viewBox="0 0 380 240" role="img" aria-label="A-mini side and rear views drawn over the original A outline: body 80 long, 56 tall, 70 wide, 2.4 inch screen on the rear, short lens barrel, 90 mm grip holding an 18650 cell, trigger REC.">
        <text x="6" y="12" class="view">Side</text>
        <g class="ghost">
          <rect x="8" y="48" width="24" height="48" rx="4" class="part"/>
          <rect x="30" y="32" width="150" height="80" rx="10" class="part"/>
          <polygon points="78,112 122,112 132,218 90,218" class="part"/>
        </g>
        <text x="140" y="28" class="lbl-part">original A</text>

