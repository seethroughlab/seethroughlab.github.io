---
import Base from '../../layouts/Base.astro';
import VideoPlayer from '../../components/VideoPlayer.astro';
import InstagramEmbed from '../../components/InstagramEmbed.astro';
import VideoGrid from '../../components/VideoGrid.astro';
import { getCollection, render } from 'astro:content';

export async function getStaticPaths() {
  const research = await getCollection('research');
  return research.map((entry) => ({
    params: { slug: entry.data.slug },
    props: { entry },
  }));
}

const { entry } = Astro.props;
const { title, subtitle, status, coverImage, githubUrl, labUrl, videoSrc, videoAspect, appStoreUrl, betaUrl, instagramPosts, videos, credits } = entry.data;
const { Content } = await render(entry);

const statusStyles: Record<string, string> = {
  active: 'border-emerald-800 text-emerald-500',
  archived: 'border-border text-text-muted',
  experiment: 'border-amber-800 text-amber-500',
};
---

<Base title={`${title} | See Through Lab`}>
  <article class="py-12">
    {/* Hero: video, else cover image */}
    {videoSrc ? (
      <div class="max-w-5xl mx-auto mb-12">
        <VideoPlayer src={videoSrc} poster={videoSrc.replace('index.m3u8', 'poster.jpg')} aspectRatio={videoAspect || undefined} />
      </div>
    ) : coverImage && (
      <div class="max-w-5xl mx-auto aspect-video overflow-hidden mb-12">
        <img
          src={coverImage}
          alt={title}
          class="w-full h-full object-cover"
        />
      </div>
    )}

    <div class="max-w-3xl mx-auto">
      {/* Status badge */}
      <span class={`inline-block text-xs uppercase tracking-wider rounded-full border px-3 py-1 mb-4 ${statusStyles[status]}`}>
        {status}
      </span>

      <h1 class="font-serif text-4xl md:text-5xl mb-4">{title}</h1>

      {subtitle && (
        <p class="text-text-muted text-lg mb-6">{subtitle}</p>
      )}

      {/* Action links */}
      {(githubUrl || labUrl || appStoreUrl || betaUrl) && (
        <div class="flex flex-wrap items-center gap-3 mb-12">
          {githubUrl && (
            <a
              href={githubUrl}
              target="_blank"
              rel="noopener noreferrer"
              class="inline-flex items-center gap-2 text-sm uppercase tracking-widest text-text-muted border border-border px-4 py-2 rounded-full hover:text-text-primary hover:border-text-muted transition-colors duration-200"
            >
              GitHub
            </a>
          )}
          {labUrl && (
            <a
              href={labUrl}
              class="inline-flex items-center gap-2 text-sm uppercase tracking-widest text-text-muted border border-border px-4 py-2 rounded-full hover:text-text-primary hover:border-text-muted transition-colors duration-200"
            >
              Launch
            </a>
          )}
          {betaUrl && (
            <a
              href={betaUrl}
              target="_blank"
              rel="noopener noreferrer"
              class="inline-flex items-center gap-2 text-sm uppercase tracking-widest text-text-muted border border-border px-4 py-2 rounded-full hover:text-text-primary hover:border-text-muted transition-colors duration-200"
            >
              Join the Beta
            </a>
          )}
          {appStoreUrl && (
            <a
              href={appStoreUrl}
              target="_blank"
              rel="noopener noreferrer"
              aria-label={`Download ${title} on the App Store`}
              class="inline-block transition-opacity duration-200 hover:opacity-80"
            >
              <img
                src="/images/app-store-badge.svg"
                alt="Download on the App Store"
                height="40"
                class="h-10 w-auto"
              />
            </a>
          )}
        </div>
      )}

      {/* Spacing when no action links */}
      {!githubUrl && !labUrl && !appStoreUrl && !betaUrl && <div class="mb-12" />}

      {/* MDX body */}
      <div class="prose">
        <Content />
      </div>

      {credits.length > 0 && (
        <dl class="mt-12 border-t border-border pt-8 text-sm grid grid-cols-[7rem_1fr] gap-2">
          <dt class="text-[0.65rem] uppercase tracking-widest text-text-muted pt-0.5">Team</dt>
          <dd>
            <dl class="space-y-1">
              {credits.map(({ role: r, name, url }) => (
                <div class="grid grid-cols-[10rem_1fr] gap-2">
                  <dt class="text-text-muted">{r}</dt>
                  <dd>
                    {url
                      ? <a href={url} target="_blank" rel="noopener noreferrer" class="text-text-primary hover:underline">{name}</a>
                      : <span class="text-text-primary">{name}</span>
                    }
                  </dd>
                </div>
              ))}
            </dl>
          </dd>
        </dl>
      )}
    </div>

    {/* Videos */}
    {videos && videos.length > 0 && (
      <div class="max-w-5xl mx-auto mt-12">
        <VideoGrid videos={videos} links={instagramPosts} />
      </div>
    )}

    {/* Instagram posts */}
    {instagramPosts && instagramPosts.length > 0 && (
      <div class="max-w-5xl mx-auto mt-12">
        <div class="grid grid-cols-1 md:grid-cols-2 gap-6">
          {instagramPosts.map((url: string) => (
            <InstagramEmbed url={url} />
          ))}
        </div>
      </div>
    )}

    <div class="max-w-3xl mx-auto">
      {/* Back navigation */}
      <a
        href="/research"
        class="inline-block mt-16 text-text-muted hover:text-text-primary transition-colors duration-200 text-sm uppercase tracking-widest"
      >
        &larr; Back to Research
      </a>
    </div>
  </article>
</Base>
