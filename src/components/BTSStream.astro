---
interface Props {
  manifestUrl: string;
}

const { manifestUrl } = Astro.props;
---

<section
  data-bts-root
  class="relative h-dvh w-full overflow-hidden bg-bg text-text-primary"
  aria-label="Behind the scenes stream"
>
  <video
    data-bts-video="A"
    class="absolute inset-0 h-full w-full object-cover opacity-0 transition-opacity duration-[1500ms] ease-linear"
    muted
    playsinline
    preload="metadata"
    crossorigin="anonymous"
  ></video>
  <video
    data-bts-video="B"
    class="absolute inset-0 h-full w-full object-cover opacity-0 transition-opacity duration-[1500ms] ease-linear"
    muted
    playsinline
    preload="metadata"
    crossorigin="anonymous"
  ></video>

  <canvas
    data-bts-canvas
    class="pointer-events-none absolute inset-0 h-full w-full"
    aria-hidden="true"
  ></canvas>

  <div class="absolute left-0 top-0 z-20 p-5 md:p-6">
    <a
      href="/"
      class="text-white/35 transition-colors duration-200 hover:text-white/80"
      aria-label="Back to home"
    >
      ←
    </a>
  </div>

  <div class="pointer-events-none absolute inset-x-0 bottom-0 z-10 flex items-end justify-between p-5 md:p-6">
    <div class="flex flex-col gap-0.5">
      <p class="max-w-[60vw] text-[0.65rem] uppercase tracking-[0.28em] text-white/35">
        See Through Lab Behind The Scenes
      </p>
      <p
        data-bts-clip-info
        class="max-w-[60vw] truncate text-[0.65rem] tracking-wide text-white/40"
      ></p>
    </div>
  </div>

  <div class="absolute inset-x-0 bottom-0 z-20 flex items-end justify-end gap-2 p-5 md:p-6">
    <button
      type="button"
      data-bts-skip
      class="cursor-pointer border border-white/15 bg-black/30 px-3 py-2 text-[0.65rem] uppercase tracking-[0.28em] text-white/55 transition-colors duration-200 hover:border-white/30 hover:text-white"
    >
      Skip
    </button>
    <div class="flex items-center gap-2 border border-white/15 bg-black/30 px-3 py-2">
      <span class="text-[0.65rem] uppercase tracking-[0.28em] text-white/35">Vol</span>
      <input
        type="range"
        data-bts-volume
        min="0"
        max="1"
        step="0.01"
        value="0"
        class="w-20 cursor-pointer accent-white opacity-55 transition-opacity duration-200 hover:opacity-100"
        aria-label="Volume"
      />
    </div>
  </div>

  <div
    data-bts-portrait-modal
    class="pointer-events-none absolute inset-0 z-40 flex flex-col items-center justify-center bg-black/50 opacity-0 transition-opacity duration-500"
    aria-hidden="true"
  >
    <div class="phone-rotate-icon mb-5 text-white/55">
      <svg width="48" height="48" viewBox="0 0 48 48" fill="none" stroke="currentColor" stroke-width="1.5" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true">
        <!-- Phone body (portrait) -->
        <rect x="15" y="6" width="18" height="30" rx="3" />
        <circle cx="24" cy="32" r="1.5" fill="currentColor" stroke="none" />
        <!-- Rotation arrow -->
        <path d="M38 10 A16 16 0 0 1 38 38" stroke-dasharray="4 3" />
        <polyline points="38,10 34,10 34,14" />
      </svg>
    </div>
    <p class="text-[0.65rem] uppercase tracking-[0.28em] text-white/45">Rotate for the full experience</p>
  </div>

  <div
    data-bts-start-overlay
    class="absolute inset-0 z-30 hidden items-center justify-center bg-black/80 p-6"
  >
    <button
      type="button"
      data-bts-start-button
      class="cursor-pointer border border-white/20 bg-black/60 px-6 py-4 text-center text-sm uppercase tracking-[0.28em] text-white transition-colors duration-200 hover:border-white/40"
    >
      Tap To Start
    </button>
  </div>

  <div
    data-bts-status
    class="pointer-events-none absolute left-1/2 top-1/2 z-20 hidden -translate-x-1/2 -translate-y-1/2 border border-white/10 bg-black/45 px-4 py-3 text-[0.7rem] uppercase tracking-[0.24em] text-white/60"
    role="status"
    aria-live="polite"
  ></div>
</section>

<script type="module" src="/bts/BTSStream.js" data-bts-manifest={manifestUrl}></script>
